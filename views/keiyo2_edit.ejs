<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= data.name %>の編集</title>
</head>
<body>
  <h2><%= data.name %>の編集</h2>
  <p>ID：<%= data.id %></p>

  <form action="/keiyo2/update/<%= number %>" method="post">
    <p>
      <label for="code">駅コード</label>
      <input type="text" name="code" id="code" value="<%= data.code %>" required>
    </p>
    <p>
      <label for="name">駅名</label>
      <input type="text" name="name" id="name" value="<%= data.name %>" required>
    </p>
    <p>
      <label for="change">乗り換え線（ない場合は空欄）</label>
      <input type="text" name="change" id="change" value="<%= data.change %>">
    </p>
    <p>
      <label for="passengers">乗降客数（人）</label>
      <input type="number" name="passengers" id="passengers" min="0" step="1" value="<%= data.passengers %>" required>
    </p>
    <p>
      <label for="distance">東京駅からの距離（km）</label>
      <input type="number" name="distance" id="distance" min="0" step="any" value="<%= data.distance %>" required>
    </p>
    <input type="submit" value="更新">
  </form>

  <p><a href="/keiyo2/<%= number %>">詳細に戻る</a></p>
  <p><a href="/keiyo2">駅一覧に戻る</a></p>
</body>
</html>
