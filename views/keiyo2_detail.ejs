<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>

  <table border="1">
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>駅コード</td><td><%= data.code %></td></tr>
    <tr><td>駅名</td><td><%= data.name %></td></tr>
    <tr><td>乗り換え線</td><td><%= data.change %></td></tr>
    <tr><td>乗降客数</td><td><%= data.passengers %>人</td></tr>
    <tr><td>東京駅からの距離</td><td><%= data.distance %> km</td></tr>
  </table>

  <a href="/keiyo2/edit/<%= number %>">編集</a>
  <form action="/keiyo2/delete/<%= number %>" method="post"
      onsubmit="return confirm('この駅を削除しますか？');">
  <button type="submit">削除</button>
</form>
  <a href="/keiyo2">駅一覧に戻る</a>
</body>
</html>
